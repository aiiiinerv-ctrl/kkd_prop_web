# MySQL connection. Local dev: run `docker compose up -d mysql` first, then
# use the URL below as-is (credentials match docker-compose.yml's local-dev-only
# defaults — never reuse them anywhere real). Production uses a database
# provisioned on the DirectAdmin panel, with its own credentials set via the
# panel's env-var UI, never committed anywhere.
DATABASE_URL="mysql://kkd_prop:kkd_prop_dev_password@localhost:3306/kkd_prop_dev"

# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# First admin account, created by `npx prisma db seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# File storage: "local" writes under STORAGE_ROOT ("s3" not implemented yet)
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage"

# Temporary Pages CMS maintenance backup route. Keep disabled and unset during
# normal operation. Enable all three only inside an approved write-free window;
# remove them again immediately after the off-host snapshot is verified.
ENABLE_PAGES_CMS_BACKUP_ROUTE="false"
PAGES_CMS_BACKUP_SECRET=""
BACKUP_WRITES_QUIESCED="false"

# Temporary Home CMS one-time backfill route (issue #61, Sprint H1). Keep
# disabled/unset during normal operation. Enable only for the duration of the
# one-time production HomePageContent/HomeFaqItem backfill (production cannot
# run `tsx`), then disable and redeploy immediately after a verified response.
ENABLE_HOME_CMS_BACKFILL_ROUTE="false"
HOME_CMS_BACKFILL_SECRET=""

# Email notifications via Resend — all three required to enable the channel
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM="KKD Solar <noreply@example.com>"
NOTIFY_EMAIL_TO="admin@example.com"

# LINE notifications via LINE Messaging API (push through your LINE OA).
# LINE_NOTIFY_TO = comma-separated LINE userIds or a group id. Both required to enable.
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_NOTIFY_TO=""

# Public site URL — used in notification deep links, canonical/hreflang tags,
# sitemap.xml and robots.txt. Leave this at localhost for development; the
# production value lives in the committed .env.production, because sitemap.xml
# and robots.txt are prerendered at build time and the deploy build container
# never sees this file (.dockerignore excludes .env).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
