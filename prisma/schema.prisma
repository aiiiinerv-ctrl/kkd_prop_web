generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SALES
  FINANCE
  CHANNEL_EXECUTIVE
  // Read-only / content-scoped roles added 2026-08-16 (RBAC sprint) — see
  // docs/plans/rbac-marketing-editor-executive-tasks.md for the permission matrix.
  MARKETING
  EDITOR
  EXECUTIVE
}

enum LeadType {
  QUOTE
  SURVEY
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUOTED
  SIGNED
  INSTALLING
  COMPLETED
  DISQUALIFIED
}

enum BuildingType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  OTHER
}

enum TimeSlot {
  MORNING
  AFTERNOON
}

enum PaymentStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARED
  SURVEYED
  DESIGNED
  SIGNED
  CANCELLED
}

enum ChannelType {
  INDIVIDUAL
  COMPANY
  PLATFORM
}

enum ServiceKind {
  SYSTEM
  MAINTENANCE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         Role       @default(SALES)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  // CHANNEL_EXECUTIVE-role accounts are scoped to the leads/status of one
  // linked ChannelExecutive (and by extension its PromoChannel). Nullable
  // because ADMIN/SALES/FINANCE accounts never set this.
  linkedChannelExecutiveId String?
  linkedChannelExecutive   ChannelExecutive? @relation("AdminUserLinkedExecutive", fields: [linkedChannelExecutiveId], references: [id])

  assignedLeads               Lead[]          @relation("LeadAssignedSales")
  assignedBookingsAsSales     SurveyBooking[] @relation("BookingAssignedSales")
  assignedBookingsAsEngineer  SurveyBooking[] @relation("BookingAssignedEngineer")
}

model PromoChannel {
  id         String             @id @default(cuid())
  slug       String
  nameTh     String
  nameEn     String
  type       ChannelType        @default(INDIVIDUAL)
  // "ประเภทช่องทางย่อย" — a 2-letter code from src/lib/channel-taxonomy.ts
  // (TE/LN/LO/TT/FB/WS/CP/RF/EF/AG), also the refCode prefix for channels
  // created after this column shipped. Plain VarChar rather than a Prisma
  // enum on purpose: production has no SSH, so adding an 11th value later
  // must not require an `ALTER TABLE … MODIFY` through phpMyAdmin — the
  // closed set is enforced by zod in src/actions/channels.ts instead.
  // Nullable so the 6 pre-existing channels (refCode CH0xx) keep resolving;
  // this column is never used to validate or reshape an old refCode.
  subType    String?            @db.VarChar(4)
  // Landing page for this channel's promo link. Choices come from
  // PROMO_LANDING_PATH_OPTIONS in src/lib/channel-taxonomy.ts and are
  // validated server-side via isPromoLandingPath() before writes.
  landingPath String            @default("/th/packages")
  // utm_campaign for this channel's promo link — one of CHANNEL_UTM_CAMPAIGNS,
  // nullable because it has no meaningful default until an admin picks one.
  utmCampaign String?           @db.VarChar(60)
  refCode    String             @unique
  isActive   Boolean            @default(true)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  leads      Lead[]
  autoLeads  Lead[]             @relation("LeadAutoSourceChannel")
  executives ChannelExecutive[]
}

// Landing-path options are no longer read from this table — they come from
// PROMO_LANDING_PATH_OPTIONS in src/lib/channel-taxonomy.ts. This model is
// retained so the production table and existing AuditLog rows that reference
// "PromoLandingPath" remain valid; dropping it can be a separate migration.
model PromoLandingPath {
  id        String   @id @default(cuid())
  // 180 keeps the utf8mb4 unique index below the host's key-length limit.
  path      String   @unique @db.VarChar(180)
  createdAt DateTime @default(now())
}

model ChannelExecutive {
  id        String       @id @default(cuid())
  channelId String
  channel   PromoChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  refCode   String       @unique
  createdAt DateTime     @default(now())
  autoLeads Lead[]       @relation("LeadAutoSourceExecutive")
  linkedAdminUsers AdminUser[] @relation("AdminUserLinkedExecutive")
}

model Lead {
  id              String         @id @default(cuid())
  type            LeadType
  status          LeadStatus     @default(NEW)
  name            String
  phone           String
  lineId          String?
  // Free-text name of whoever personally referred this lead — supplementary
  // info, distinct from sourceChannelId (a marketing channel from a dropdown).
  referrerName    String?
  province        String
  buildingType    BuildingType
  // Free-text detail, required only when buildingType === OTHER (validated
  // in src/lib/validations/lead.ts via superRefine).
  buildingTypeOtherText String?
  avgMonthlyBill  Int?
  // Array of "ON_GRID"|"HYBRID"|"OFF_GRID" — quote-form only ("ระบบที่สนใจ"
  // multi-select). Used as the "ประเภทระบบ" export column (see
  // src/lib/reports/export-rows.ts). Null for SURVEY-type leads.
  interestedSystems Json?
  // Slug of the Package/Service the lead clicked "request quote" from (the
  // `?package=`/`?service=` query param on the booking link — see
  // src/lib/booking-links.ts). Server-validated against the Package/Service
  // table at submit time (submit-quote.ts / submit-survey-booking.ts); an
  // unrecognized slug is stored as null rather than the raw param. This is
  // link-click context, not something the customer typed in.
  interestedPackageSlug String?
  interestedServiceSlug String?
  locale          String         @default("th")
  sourceChannelId String?
  sourceChannel   PromoChannel?  @relation(fields: [sourceChannelId], references: [id])
  autoSourceChannelId   String?
  autoSourceChannel     PromoChannel?     @relation("LeadAutoSourceChannel", fields: [autoSourceChannelId], references: [id])
  autoSourceExecutiveId String?
  autoSourceExecutive   ChannelExecutive? @relation("LeadAutoSourceExecutive", fields: [autoSourceExecutiveId], references: [id])
  // Campaign tracking, separate from the sourceChannelId/autoSourceChannelId
  // pair above (docs/plans/sa-channel-taxonomy-utm-tasks.md Default #1):
  // `kkd_ref` is per-channel/per-person attribution used for channel
  // counting in reports (effectiveChannel() in src/lib/reports/aggregate.ts
  // never reads these), while these columns are ad-campaign metadata read
  // from the `kkd_utm` cookie (src/lib/utm.ts) at submit time. Both can be
  // set on the same lead; neither one derives the other.
  utmSource       String?        @db.VarChar(120)
  utmMedium       String?        @db.VarChar(120)
  utmCampaign     String?        @db.VarChar(120)
  utmContent      String?        @db.VarChar(120)
  utmTerm         String?        @db.VarChar(120)
  landingPath     String?        @db.VarChar(200)
  assignedSalesId String?
  assignedSales   AdminUser?     @relation("LeadAssignedSales", fields: [assignedSalesId], references: [id])
  lastFollowUpAt  DateTime?
  // Set once, the first time a lead's status transitions into SIGNED (see
  // updateLeadStatus() in src/actions/leads.ts) — represents "วันที่ปิดการขาย"
  // per the requirements PDF §4.5 export field list. Not cleared when the
  // lead advances further (INSTALLING/COMPLETED); not backfilled for leads
  // that were already SIGNED+ before this column existed (stays null, shown
  // as "-" in the export).
  closedAt        DateTime?
  // Written once by the public submit actions at create time
  // (submit-quote.ts / submit-survey-booking.ts) — no admin action ever
  // writes this. What the customer typed into "ข้อความเพิ่มเติม".
  customerMessage String?        @db.Text
  // Admin-only free text ("บันทึกภายใน"), written by updateLeadNotes().
  // Column in the DB is still named "notes" for historical reasons (this
  // field used to double as both the customer's message and the admin's
  // notes, which is why customerMessage above exists as a separate column)
  // — renaming the DB column isn't worth the migration risk on a host with
  // no external MySQL access, so we keep the @map and rename only the
  // Prisma-side field name.
  internalNotes   String?        @db.Text @map("notes")
  booking         SurveyBooking?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
}

model SurveyBooking {
  id                 String        @id @default(cuid())
  leadId             String        @unique
  lead               Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bookingNumber      String        @unique
  address            String        @db.Text
  preferredDate      DateTime
  timeSlot           TimeSlot
  amountThb          Int           @default(199)
  paymentSlipKey     String
  paymentStatus      PaymentStatus @default(PENDING_REVIEW)
  status             BookingStatus @default(PENDING_CONFIRMATION)
  giftSent           Boolean       @default(false)
  assignedEngineerId String?
  assignedEngineer   AdminUser?    @relation("BookingAssignedEngineer", fields: [assignedEngineerId], references: [id])
  assignedSalesId    String?
  assignedSales      AdminUser?    @relation("BookingAssignedSales", fields: [assignedSalesId], references: [id])
}

model BookingCapacitySetting {
  id         String   @id @default(cuid())
  maxPerDay  Int      @default(4)
  maxPerSlot Int      @default(2)
  updatedAt  DateTime @updatedAt
}

// Singleton — site-wide contact info, social links, header/footer text.
// All content columns are nullable so the app can fallback to messages/*.json
// when a row exists but a field has never been filled in.
model SiteSettings {
  id                  String   @id @default(cuid())
  phone               String?
  email               String?
  addressTh           String?
  addressEn           String?
  hoursTh             String?
  hoursEn             String?
  mapQuery            String?
  lineUrl             String?
  facebookUrl         String?
  instagramUrl        String?
  tiktokUrl           String?
  youtubeUrl          String?
  footerDescriptionTh String?  @db.Text
  footerDescriptionEn String?  @db.Text
  contactTitleTh      String?
  contactTitleEn      String?
  contactSubtitleTh   String?
  contactSubtitleEn   String?
  headerCtaLabelTh    String?
  headerCtaLabelEn    String?
  updatedAt           DateTime @updatedAt
}

// Per-page SEO data — one row per MetaKey (10 rows in seed).
// `key` is constrained to META_KEYS at the zod level, not with a Prisma enum,
// so production can never need an ALTER TABLE to extend it.
model PageSeo {
  id            String   @id @default(cuid())
  key           String   @unique @db.VarChar(40)
  titleTh       String?
  titleEn       String?
  descriptionTh String?  @db.Text
  descriptionEn String?  @db.Text
  ogImageKey    String?
  updatedAt     DateTime @updatedAt
}

// Singleton — editable content for the about page (ADMIN|SALES|MARKETING|EDITOR).
// Matches the 16 user-facing fields from messages.about (excludes numbersTitle
// which belongs to StatsRow and must not be touched here).
model AboutContent {
  id                    String   @id @default(cuid())
  titleTh               String?
  titleEn               String?
  introTh               String?  @db.Text
  introEn               String?  @db.Text
  credRegisteredTitleTh String?
  credRegisteredTitleEn String?
  credRegisteredDescTh  String?  @db.Text
  credRegisteredDescEn  String?  @db.Text
  credEngineerTitleTh   String?
  credEngineerTitleEn   String?
  credEngineerDescTh    String?  @db.Text
  credEngineerDescEn    String?  @db.Text
  credExperienceTitleTh String?
  credExperienceTitleEn String?
  credExperienceDescTh  String?  @db.Text
  credExperienceDescEn  String?  @db.Text
  teamTitleTh           String?
  teamTitleEn           String?
  teamDescTh            String?  @db.Text
  teamDescEn            String?  @db.Text
  teamDesignTitleTh     String?
  teamDesignTitleEn     String?
  teamDesignDescTh      String?  @db.Text
  teamDesignDescEn      String?  @db.Text
  teamInstallTitleTh    String?
  teamInstallTitleEn    String?
  teamInstallDescTh     String?  @db.Text
  teamInstallDescEn     String?  @db.Text
  teamSupportTitleTh    String?
  teamSupportTitleEn    String?
  teamSupportDescTh     String?  @db.Text
  teamSupportDescEn     String?  @db.Text
  updatedAt             DateTime @updatedAt
}

// Singleton (mirrors BookingCapacitySetting) — admin-configurable payment
// info shown on the public survey-booking form (bank transfer + PromptPay QR).
model PaymentSettings {
  id                String   @id @default(cuid())
  promptpayId       String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  updatedAt         DateTime @updatedAt
}

model Service {
  id            String      @id @default(cuid())
  slug          String      @unique
  kind          ServiceKind
  titleTh       String
  titleEn       String
  descriptionTh String      @db.Text
  descriptionEn String      @db.Text
  featuresTh    Json?
  featuresEn    Json?
  imageKey      String?
  sortOrder     Int         @default(0)
  isPublished   Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Package {
  id                 String   @id @default(cuid())
  slug               String   @unique
  nameTh             String
  nameEn             String
  sizeKw             Float
  priceThb           Int
  isPopular          Boolean  @default(false)
  suitableTh         String   @db.Text
  suitableEn         String   @db.Text
  featuresTh         Json
  featuresEn         Json
  seasonalProduction Json
  imageKey           String?
  sortOrder          Int      @default(0)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PortfolioProject {
  id            String        @id @default(cuid())
  slug          String        @unique
  titleTh       String
  titleEn       String
  descriptionTh String        @db.Text
  descriptionEn String        @db.Text
  category      BuildingType
  province      String
  systemSizeKw  Float
  imageKeys     Json
  completedAt   DateTime?
  sortOrder     Int           @default(0)
  isPublished   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  testimonials  Testimonial[]

  @@index([category, isPublished])
}

model Testimonial {
  id           String           @id @default(cuid())
  customerName String
  quoteTh      String           @db.Text
  quoteEn      String           @db.Text
  role         String?
  province     String?
  photoKey     String?
  projectId    String?
  project      PortfolioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sortOrder    Int              @default(0)
  isPublished  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([isPublished, sortOrder])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      AdminUser   @relation(fields: [actorId], references: [id])
  action     AuditAction
  // Explicit shorter lengths (longest real value is a model name / cuid,
  // both well under these caps) — the composite index below on two
  // default VARCHAR(191) utf8mb4 columns exceeded the production host's
  // inherited MyISAM 1000-byte key limit (error 1071). See ADR-0006.
  entityType String @db.VarChar(50)
  entityId   String @db.VarChar(40)
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
