# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
prisma/*.db
prisma/*.db-journal

# generated prisma client
/src/generated/

# uploaded files
/storage/

# local backup snapshots (scripts/backup-db.mts)
/backups/

# one-off SQLite-to-JSON dump for the MySQL cutover (scripts/dump-sqlite-to-json.mts)
# — contains real customer PII when generated from a production backup, never commit
/migration-data.json

# generated screenshots (verification output, not source)
/screenshots/

# client-supplied documents (company registration certificate, requirement PDFs,
# pricing spreadsheets) — this repo is PUBLIC, these must never be committed
/docs/stuffs/

# firebase CLI deploy cache
/.firebase/

# shared-hosting deploy artifact staging (scripts/build-shared-hosting-deploy.mts)
/deploy/dist/
/deploy/dist.zip
/deploy/linux-build/

# local Claude Code settings overrides (may contain machine-specific permission rules)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
